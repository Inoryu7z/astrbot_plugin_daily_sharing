{
  "personas": {
    "description": "🎭 多人格配置",
    "type": "template_list",
    "hint": "为每个人格配置独立的分享参数。新建人格时默认值与全局设置相同，可按需修改。至少添加一个人格才能启用多人格模式。",
    "templates": {
      "persona": {
        "items": {
          "persona_name": {
            "description": "人格标识",
            "type": "string",
            "default": "",
            "hint": "选择要绑定的AstrBot人格，该人格的分享将使用此模板的配置",
            "_special": "select_persona"
          },
          "enabled": {
            "description": "启用此人格的分享",
            "type": "bool",
            "default": true,
            "hint": "关闭后该人格不会自动分享，但手动触发仍可用"
          },
          "persona_receiver": {
            "title": "分享目标",
            "description": "该人格的独立分享目标",
            "type": "object",
            "hint": "为该人格指定独立的分享目标。留空则回退到全局 receiver 配置",
            "items": {
              "adapter_id": {
                "title": "目标适配器ID",
                "type": "string",
                "default": "",
                "hint": "指定消息发送的目标适配器ID（如 aiocqhttp）。留空则自动发现或回退到全局配置"
              },
              "groups": {
                "title": "群聊独立配置",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "分享到群聊",
                "default": [],
                "hint": "格式：1. 仅群号=跟随全局 2. 群号:类型=仅指定类型。类型：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "users": {
                "title": "私聊独立配置",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "分享到私聊",
                "default": [],
                "hint": "格式同群聊，将群号替换为QQ号。默认与全局相同，可修改"
              }
            }
          },
          "persona_basic_conf": {
            "description": "⏰ 基础设置",
            "type": "object",
            "hint": "该人格的独立基础设置，默认与全局相同，可修改",
            "items": {
              "trigger_mode": {
                "description": "触发模式",
                "type": "string",
                "default": "random_period",
                "options": [
                  "",
                  "random_period",
                  "cron"
                ],
                "hint": "random_period=在随机时段内随机触发 | cron=按Cron表达式固定时间触发。默认与全局相同，可修改"
              },
              "sharing_cron": {
                "description": "Cron表达式",
                "type": "string",
                "default": "0 8,20 * * *",
                "hint": "仅cron模式生效，如 0 8,20 * * * 表示每天8点和20点。默认与全局相同，可修改"
              },
              "sharing_type": {
                "description": "分享类型策略",
                "type": "string",
                "default": "auto",
                "options": [
                  "",
                  "auto",
                  "greeting",
                  "news",
                  "mood",
                  "life_moment",
                  "rant",
                  "dream",
                  "recommendation"
                ],
                "hint": "auto=按心情驱动+时段序列智能选择（推荐） | 选具体类型则永远只发该类型。默认与全局相同，可修改"
              },
              "random_periods": {
                "description": "随机分享时间段",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "08:00-10:00",
                  "19:00-21:00"
                ],
                "hint": "仅random_period模式生效。格式：HH:MM-HH:MM。默认与全局相同，可修改"
              },
              "dawn_sequence": {
                "description": "【序列】凌晨",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "dream",
                  "mood"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "morning_sequence": {
                "description": "【序列】早晨",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "greeting"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "forenoon_sequence": {
                "description": "【序列】上午",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "news",
                  "life_moment"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "afternoon_sequence": {
                "description": "【序列】下午",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "news",
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "evening_sequence": {
                "description": "【序列】傍晚",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "recommendation",
                  "life_moment"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "night_sequence": {
                "description": "【序列】夜晚",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "recommendation",
                  "mood"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              },
              "late_night_sequence": {
                "description": "【序列】深夜",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "dream"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation。默认与全局相同，可修改"
              }
            }
          },
          "persona_llm_conf": {
            "description": "🤖 模型与人设",
            "type": "object",
            "hint": "该人格的独立模型配置，默认与全局相同，可修改",
            "items": {
              "llm_provider_id": {
                "description": "LLM提供商",
                "type": "string",
                "default": "",
                "hint": "为该人格指定独立的LLM提供商。不选择或指定失败后自动降级使用默认模型。默认与全局相同，可修改",
                "_special": "select_provider"
              },
              "llm_timeout": {
                "description": "生成超时(秒)",
                "type": "int",
                "default": 120,
                "hint": "该人格的LLM生成内容最大等待时间（秒）。0表示回退全局"
              },
              "persona_id": {
                "description": "指定人设ID",
                "type": "string",
                "default": "",
                "hint": "可选择已配置的人设，留空则使用当前人格对应的人设",
                "_special": "select_persona"
              }
            }
          },
