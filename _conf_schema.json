{
  "personas": {
    "description": "🎭 多人格配置",
    "type": "template_list",
    "hint": "为每个人格配置独立的分享参数。添加人格条目后开箱即用，所有字段均有合理默认值。",
    "templates": {
      "persona": {
        "items": {
          "persona_name": {
            "description": "人格标识",
            "type": "string",
            "default": "",
            "hint": "选择要绑定的AstrBot人格，该人格的分享将使用此模板的配置",
            "_special": "select_persona"
          },
          "persona_receiver": {
            "title": "分享目标",
            "description": "该人格的独立分享目标",
            "type": "object",
            "hint": "为该人格指定独立的分享目标",
            "items": {
              "adapter_id": {
                "title": "目标适配器ID",
                "type": "string",
                "default": "",
                "hint": "指定消息发送的目标适配器ID（如 aiocqhttp）。留空则自动发现"
              },
              "groups": {
                "title": "群聊独立配置",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "分享到群聊",
                "default": [],
                "hint": "格式：1. 仅群号 2. 群号:类型=仅指定类型。类型：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "users": {
                "title": "私聊独立配置",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "分享到私聊",
                "default": [],
                "hint": "格式同群聊，将群号替换为QQ号"
              }
            }
          },
          "persona_basic_conf": {
            "description": "⏰ 基础设置",
            "type": "object",
            "hint": "该人格的独立基础设置",
            "items": {
              "random_periods": {
                "description": "随机分享时间段",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "08:00-10:00",
                  "19:00-21:00"
                ],
                "hint": "格式：HH:MM-HH:MM"
              },
              "dawn_sequence": {
                "description": "【序列】凌晨 (00:00-06:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "dream",
                  "mood"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "morning_sequence": {
                "description": "【序列】早晨 (06:00-09:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "greeting",
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "forenoon_sequence": {
                "description": "【序列】上午 (09:00-12:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "news",
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "afternoon_sequence": {
                "description": "【序列】下午 (12:00-16:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "evening_sequence": {
                "description": "【序列】傍晚 (16:00-19:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "rant",
                  "life_moment"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "night_sequence": {
                "description": "【序列】夜晚 (19:00-22:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "greeting",
                  "life_moment",
                  "rant",
                  "mood"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              },
              "late_night_sequence": {
                "description": "【序列】深夜 (22:00-24:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "rant"
                ],
                "hint": "auto模式下智能选择，无需按顺序填。候选：greeting,news,mood,life_moment,rant,dream,recommendation"
              }
            }
          },
          "persona_llm_conf": {
            "description": "🤖 模型与人设",
            "type": "object",
            "hint": "该人格的独立模型配置",
            "items": {
              "llm_provider_id": {
                "description": "LLM提供商",
                "type": "string",
                "default": "",
                "hint": "为该人格指定独立的LLM提供商。留空则使用系统默认模型",
                "_special": "select_provider"
              }
            }
          },
          "persona_image_conf": {
            "description": "🎨 配图与视频",
            "type": "object",
            "hint": "该人格的独立配图配置",
            "items": {
              "enable_ai_image": {
                "description": "启用生成配图",
                "type": "bool",
                "default": false,
                "hint": "需要安装 astrbot_plugin_aiimg 插件并配置自拍参考照。配图使用自拍模式保持形象一致性"
              },
              "image_enabled_types": {
                "description": "允许配图的类型",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "greeting",
                  "mood",
                  "life_moment",
                  "dream",
                  "recommendation",
                  "rant"
                ],
                "hint": "仅当分享类型在列表中时才会生成图片"
              },
              "enable_ai_video": {
                "description": "启用生成视频",
                "type": "bool",
                "default": false,
                "hint": "需要 astrbot_plugin_gitee_aiimg 插件配置Grok，将配图转换为视频"
              },
              "enable_smart_video_prompt": {
                "description": "启用智能视频提示词",
                "type": "bool",
                "default": true,
                "hint": "使用多模态模型分析图片内容，生成针对性的视频提示词（需要配置支持识图的LLM）"
              },
              "video_llm_provider_id": {
                "description": "视频识图LLM提供商",
                "type": "string",
                "default": "",
                "hint": "用于视频识图的多模态模型。留空则使用全局LLM。必须支持图片输入",
                "_special": "select_provider"
              }
            }
          },
          "persona_tts_conf": {
            "description": "🗣️ 语音设置",
            "type": "object",
            "hint": "该人格的独立TTS配置",
            "items": {
              "enable_tts": {
                "description": "启用语音转换",
                "type": "bool",
                "default": false,
                "hint": "必须先安装并配置好 astrbot_plugin_tts_emotion_router"
              }
            }
          },
          "persona_qzone_conf": {
            "description": "🌟 QQ空间说说",
            "type": "object",
            "hint": "该人格的独立QQ空间配置",
            "items": {
              "enable_qzone": {
                "description": "启用定时分享说说",
                "type": "bool",
                "default": false,
                "hint": "开启后将按下方规则自动分享QQ空间说说"
              },
              "qzone_random_periods": {
                "description": "说说随机触发时间段",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "08:00-10:00",
                  "19:00-21:00"
                ],
                "hint": "格式：HH:MM-HH:MM"
              },
              "qzone_enable_image": {
                "description": "启用说说配图",
                "type": "bool",
                "default": false,
                "hint": "需在配图设置中开启生成配图总开关"
              },
              "qzone_image_enabled_types": {
                "description": "允许说说配图的类型",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "greeting",
                  "mood",
                  "life_moment",
                  "dream",
                  "rant"
                ],
                "hint": "仅当说说分享类型在列表中时才会生成图片"
              },
              "qzone_dawn_sequence": {
                "description": "【序列】凌晨 (00:00-06:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "dream",
                  "mood"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_morning_sequence": {
                "description": "【序列】早晨 (06:00-09:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_forenoon_sequence": {
                "description": "【序列】上午 (09:00-12:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_afternoon_sequence": {
                "description": "【序列】下午 (12:00-16:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_evening_sequence": {
                "description": "【序列】傍晚 (16:00-19:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "life_moment",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_night_sequence": {
                "description": "【序列】夜晚 (19:00-22:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              },
              "qzone_late_night_sequence": {
                "description": "【序列】深夜 (22:00-24:00)",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [
                  "mood",
                  "rant"
                ],
                "hint": "auto模式下智能选择"
              }
            }
          },
          "persona_context_conf": {
            "description": "🧠 上下文与记忆",
            "type": "object",
            "hint": "该人格的独立上下文配置",
            "items": {
              "deep_history_hours": {
                "description": "深度回溯时间范围(小时)",
                "type": "int",
                "default": 24,
                "slider": {
                  "min": 1,
                  "max": 168,
                  "step": 1
                },
                "hint": "读取过去N小时内的消息"
              },
              "deep_history_max_count": {
                "description": "【群聊】深度回溯最大条数",
                "type": "int",
                "default": 50,
                "slider": {
                  "min": 20,
                  "max": 200,
                  "step": 10
                },
                "hint": "群聊消息量大，建议50-100条"
              },
              "private_history_count": {
                "description": "【私聊】深度回溯最大条数",
                "type": "int",
                "default": 20,
                "slider": {
                  "min": 5,
                  "max": 100,
                  "step": 5
                },
                "hint": "私聊语境较慢，建议20-30条"
              },
              "group_intensity_check_count": {
                "description": "群聊热度判断范围",
                "type": "int",
                "default": 30,
                "slider": {
                  "min": 10,
                  "max": 100,
                  "step": 5
                },
                "hint": "查看最近多少条消息判断热闹程度。越小越敏感，越大越稳重"
              },
              "group_share_strategy": {
                "description": "群聊分享策略",
                "type": "string",
                "default": "cautious",
                "options": [
                  "cautious",
                  "active",
                  "minimal"
                ],
                "hint": "cautious=热烈讨论时不打断 | active=总是分享 | minimal=只在冷场时分享"
              }
            }
          },
          "persona_news_conf": {
            "description": "📰 新闻热搜",
            "type": "object",
            "hint": "该人格的独立新闻配置",
            "items": {
              "enable_news_api": {
                "description": "启用新闻热搜 API",
                "type": "bool",
                "default": true,
                "hint": "开启后分享新闻类型时会自动获取真实热搜数据。关闭则使用纯LLM生成"
              },
              "news_random_mode": {
                "description": "新闻热搜源模式",
                "type": "string",
                "default": "config",
                "options": [
                  "fixed",
                  "random",
                  "config",
                  "time_based"
                ],
                "hint": "fixed=固定源 | random=全随机 | config=从列表随机 | time_based=按时段选择"
              },
              "news_random_sources": {
                "description": "随机新闻热搜源列表",
                "type": "list",
                "items": {
                  "type": "string",
                  "options": [
                    "zhihu",
                    "weibo",
                    "bili",
                    "xiaohongshu",
                    "douyin",
                    "toutiao",
                    "baidu",
                    "tencent",
                    "quark",
                    "36kr",
                    "51cto",
                    "acfun",
                    "ifanr",
                    "netease",
                    "sina",
                    "thepaper",
                    "yicai"
                  ]
                },
                "default": [
                  "zhihu",
                  "weibo",
                  "bili"
                ],
                "hint": "config/time_based模式生效，推荐2-5个"
              },
              "news_api_source": {
                "description": "固定新闻热搜源",
                "type": "string",
                "default": "zhihu",
                "options": [
                  "zhihu",
                  "weibo",
                  "bili",
                  "xiaohongshu",
                  "douyin",
                  "toutiao",
                  "baidu",
                  "tencent",
                  "quark",
                  "36kr",
                  "51cto",
                  "acfun",
                  "ifanr",
                  "netease",
                  "sina",
                  "thepaper",
                  "yicai"
                ],
                "hint": "仅fixed模式生效"
              },
              "news_items_count": {
                "description": "获取新闻热搜条数",
                "type": "int",
                "default": 5,
                "slider": {
                  "min": 1,
                  "max": 20,
                  "step": 1
                },
                "hint": "从API获取的条数(1-20)，推荐5-10"
              },
              "news_share_count": {
                "description": "分享新闻热搜条数",
                "type": "string",
                "default": "1-2",
                "hint": "可以是固定值(如2)或范围(如2-3)"
              },
              "news_api_timeout": {
                "description": "新闻热搜 API 超时(秒)",
                "type": "int",
                "default": 30,
                "slider": {
                  "min": 1,
                  "max": 60,
                  "step": 1
                },
                "hint": "获取新闻热搜的超时时间"
              },
              "enable_tavily_search": {
                "description": "启用 Tavily 检索分享内容",
                "type": "bool",
                "default": true,
                "hint": "分享新闻和推荐时调用Tavily检索背景（需在AstrBot AI配置中配置Tavily），关闭则LLM脑补"
              }
            }
          },
          "persona_extra_shares": {
            "description": "📅 早报分享",
            "type": "object",
            "hint": "该人格的独立早报分享配置",
            "items": {
              "briefing_groups": {
                "description": "早报分享群聊",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [],
                "hint": "填入接收早报的群号。留空则不分享"
              },
              "briefing_users": {
                "description": "早报分享私聊",
                "type": "list",
                "items": {
                  "type": "string"
                },
                "default": [],
                "hint": "填入接收早报的QQ号。留空则不分享"
              },
              "cron_briefing": {
                "description": "定时分享时间",
                "type": "string",
                "default": "0 8 * * *",
                "hint": "Cron表达式，默认每天08:00"
              },
              "enable_60s_news": {
                "description": "启用分享每天60s读世界",
                "type": "bool",
                "default": false,
                "hint": "定时触发的每天60s读世界自动分享到群聊、私聊"
              },
              "enable_ai_news": {
                "description": "启用分享AI资讯快报",
                "type": "bool",
                "default": false,
                "hint": "定时触发的AI资讯快报自动分享到群聊、私聊"
              },
              "sync_briefing_to_qzone": {
                "description": "启用分享早报到QQ空间",
                "type": "bool",
                "default": false,
                "hint": "每天60s读世界和AI资讯快报也会作为说说分享到QQ空间"
              }
            }
          },
          "persona_content_library": {
            "description": "📚 内容库自定义",
            "type": "object",
            "hint": "该人格的独立内容库配置",
            "items": {
              "rec_cats": {
                "title": "推荐分类库",
                "description": "定义推荐分享的大类和子话题",
                "hint": "格式：[分类名]: [标签1, 标签2]。例如：书籍: 科幻, 悬疑",
                "type": "list",
                "items": {
                  "type": "text"
                },
                "default": [
                  "书籍: 悬疑推理, 当代文学, 历史传记, 科普新知, 商业思维, 治愈系绘本, 科幻神作, 哲学入门, 古典诗词, 艺术图鉴",
                  "电影: 高分冷门, 烧脑科幻, 经典黑白, 是枝裕和风, 赛博朋克, 奥斯卡遗珠, 纪录片, 励志传记, 暴力美学, 黑色幽默",
                  "音乐: 新世纪音乐, 治愈系钢琴, 氛围电子, 华语流行, 梦幻流行, 影视原声, 自然白噪音, 爵士蓝调, 摇滚精神, 民谣故事",
                  "动漫: 治愈日常, 硬核科幻, 热血运动, 悬疑智斗, 吉卜力风, 奇幻史诗, 冷门佳作, 机甲浪漫, 异世界冒险, 推理侦探",
                  "美食: 地方特色小吃, 创意懒人菜, 季节限定, 深夜治愈美食, 传统糕点, 异国风味, 烘焙甜点, 咖啡茶饮, 海鲜料理, 面食文化",
                  "游戏: 独立神作, 治愈解谜, 剧情向, 像素风, 肉鸽Like, 模拟经营, 开放世界, 恐怖游戏, 复古怀旧, 派对游戏",
                  "剧集: 英美神剧, 悬疑破案, 高分韩剧, 下饭情景剧, 职场爽剧, 历史正剧, 日式律政, 迷你剧, 真人秀, 讽刺喜剧",
                  "播客: 怪诞故事, 商业内幕, 历史闲聊, 科技前沿, 情感治愈, 真实罪案, 文化对谈, 读书分享, 英语听力, 助眠ASMR",
                  "好物: 桌面美学, 创意文具, 数码配件, 居家神器, 露营装备, 解压玩具, 咖啡器具, 极简收纳, 黑科技, 手工DIY",
                  "旅行: 避世古镇, 赛博城市, 海岛度假, 徒步路线, 博物馆, 自驾公路, 露营圣地, 建筑打卡, 云旅游, 特色民宿"
                ]
              }
            }
          }
        }
      }
    }
  },
  "nycnm_api_key": {
    "description": "柠柚API密钥",
    "type": "string",
    "default": "",
    "hint": "https://api.nycnm.cn 获取API密钥，所有人格共用"
  },
  "data_retention_days": {
    "description": "内容去重保留天数",
    "type": "int",
    "default": 60,
    "slider": {
      "min": 7,
      "max": 365,
