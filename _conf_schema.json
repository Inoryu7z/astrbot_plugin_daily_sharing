                "hint": "需要安装 astrbot_plugin_aiimg 插件并配置自拍参考照。默认与全局相同，可修改"
              },
              "image_enabled_types": {
                "description": "允许配图的类型",
                "type": "list",
                "items": {
                  "type": "string"
