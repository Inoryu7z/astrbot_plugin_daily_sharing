                "hint": "仅当分享类型在列表中时才会生成图片。默认与全局相同，可修改"
              },
              "enable_ai_video": {
                "description": "启用生成视频",
                "type": "string",
                "default": "false",
                "options": [
                  "",
                  "true",
                  "false"
