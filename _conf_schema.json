    "description": "⏰ 基础设置",
    "type": "object",
    "hint": "设置分享类型策略、触发模式和随机时间段。",
    "items": {
      "trigger_mode": {
        "description": "触发模式",
        "type": "string",
        "default": "random_period",
        "options": [
          "random_period",
          "cron"
        ],
        "hint": "random_period=在随机时段内随机触发 | cron=按Cron表达式固定时间触发"
